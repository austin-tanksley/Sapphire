---
import { Image } from 'astro:assets';
import quotePhoto from '../assets/Christmas_Stock/andy-holmes-5j7EenhzU2s-unsplash.jpg';
---

<section class="quote-photo" id="quote">
	<div class="quote-photo__frame">
		<Image
			class="quote-photo__bg"
			src={quotePhoto}
			alt=""
			width={960}
			height={480}
		/>
		<h2 class="quote-photo__text">
			We believe in earning your business the old-fashioned way: with hard
			work, straight answers, and displays that make your house the one
			everyone slows down to see.
		</h2>
	</div>
</section>

<style>
	.quote-photo {
		padding: var(--space-xl) var(--content-inset);
		background: var(--color-ice);
	}

	.quote-photo__frame {
		position: relative;
		padding: var(--space-lg);
		border: 3px solid var(--color-blue);
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.quote-photo__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		filter: brightness(0.85);
	}

	.quote-photo__text {
		position: relative;
		margin: 0;
		text-align: center;
		font-family: var(--font-heading);
		font-size: 1.75rem;
		font-weight: 800;
		line-height: 1.05;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--color-white);
	}

	@media (min-width: 768px) {
		.quote-photo__frame {
			padding: var(--space-2xl) var(--space-xl);
		}

		.quote-photo__text {
			font-size: 3.5rem;
		}
	}
</style>
