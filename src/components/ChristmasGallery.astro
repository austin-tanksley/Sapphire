---
const photos = [
	{ src: '/images/edited 240.png', width: 1448, height: 1086 },
	{ src: '/images/Edited 320.png', width: 1672, height: 941 },
	{ src: '/images/edited 605.png', width: 1439, height: 1093 },
	{ src: '/images/edited 1050.png', width: 1448, height: 1086 },
	{ src: '/images/edited 1800.png', width: 1379, height: 1141 },
];
---

<section class="christmas-gallery" id="gallery">
	<div class="christmas-gallery-header">
		<p class="section-label">— See Our Work</p>
		<h2 class="section-heading">Recent Installations</h2>
	</div>

	<div class="christmas-gallery-track-wrap">
		<ul class="christmas-gallery-track">
			{
				[...photos, ...photos].map((photo, i) => (
					<li class="christmas-gallery-item" aria-hidden={i >= photos.length}>
						<img
							src={photo.src}
							alt="A home decorated with a custom Christmas light display"
							width={photo.width}
							height={photo.height}
							loading="lazy"
						/>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.christmas-gallery {
		padding: var(--space-xl) 0;
		background: var(--color-ice-dark);
		overflow: hidden;
	}

	.christmas-gallery-header {
		margin: 0 var(--content-inset) var(--space-md);
		text-align: center;
	}

	.christmas-gallery-track-wrap {
		overflow: hidden;
		-webkit-mask-image: linear-gradient(
			to right,
			transparent,
			black var(--space-xl),
			black calc(100% - var(--space-xl)),
			transparent
		);
		mask-image: linear-gradient(
			to right,
			transparent,
			black var(--space-xl),
			black calc(100% - var(--space-xl)),
			transparent
		);
	}

	.christmas-gallery-track {
		list-style: none;
		display: flex;
		align-items: center;
		gap: var(--space-md);
		width: max-content;
		margin: 0;
		padding: 0;
		animation: christmas-gallery-scroll 32s linear infinite;
	}

	.christmas-gallery-track-wrap:hover .christmas-gallery-track {
		animation-play-state: paused;
	}

	.christmas-gallery-item {
		flex: 0 0 auto;
		width: min(80vw, 320px);
	}

	.christmas-gallery-item img {
		display: block;
		width: 100%;
		height: 240px;
		object-fit: cover;
		border-radius: var(--radius-md);
	}

	@keyframes christmas-gallery-scroll {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.christmas-gallery-track {
			animation: none;
		}
	}

	@media (min-width: 768px) {
		.christmas-gallery-header {
			text-align: left;
		}

		.christmas-gallery-item {
			width: 360px;
		}

		.christmas-gallery-item img {
			height: 280px;
		}
	}
</style>
