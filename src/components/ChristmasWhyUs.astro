---
const cards = [
	{
		id: 'custom-designs',
		icon: '/images/icons/design.svg',
		title: 'Custom Designs',
		body: 'Every home is different. We design a layout that fits your roofline, trees, and landscaping — not a one-size-fits-all string of lights.',
		expanded: true,
	},
	{
		id: 'commercial-grade',
		icon: '/images/icons/bulb.svg',
		title: 'Commercial-Grade LEDs',
		body: 'Bright, durable, weatherproof lights built to handle a full season outdoors — not the fragile string you\'d grab off a store shelf.',
		expanded: false,
	},
	{
		id: 'install-takedown',
		icon: '/images/icons/calendar.svg',
		title: 'Full Install & Takedown',
		body: 'We handle setup before the holidays and takedown after — including off-season storage, so lights aren\'t cluttering your garage.',
		expanded: false,
	},
	{
		id: 'safe',
		icon: '/images/icons/shield.svg',
		title: 'Safe & Fully Insured',
		body: 'No ladders, no risk. Our insured crews handle the heights so you and your family don\'t have to.',
		expanded: false,
	},
];

const bodyText =
	"Sapphire Services brings the same hard work and straight answers to holiday lighting that we bring to every window we clean. We design the layout, source the lights, install and test everything before you see it, then come back after the season to take it all down and store it. One call, done right, every year.";
---

<section class="why-us" id="why-us">
	<div class="why-us-intro">
		<p class="section-label">— The Sapphire Way</p>
		<h2 class="section-heading">Why Sapphire For Christmas Lights?</h2>
		<p class="body-text">{bodyText}</p>
	</div>

	<div class="cards">
		{
			cards.map((card) => (
				<details class="card" open={card.expanded}>
					<summary class="card-header">
						<div class="card-icon-wrap">
							<img src={card.icon} alt="" width="58" height="58" />
							<span class="card-title">{card.title}</span>
						</div>
						<span class="toggle-icon" aria-hidden="true">
							<svg width="16" height="16" viewBox="0 0 16 16" fill="none">
								<path
									class="toggle-bar toggle-bar--v"
									d="M8 3v10"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
								/>
								<path
									class="toggle-bar"
									d="M3 8h10"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
								/>
							</svg>
						</span>
					</summary>
					<div class="card-body">
						<p class="body-text">{card.body}</p>
					</div>
				</details>
			))
		}
	</div>

	<a href="#quote" class="btn btn-full quote-cta">
		Get a Free Quote in 1 Business Day
	</a>
</section>

<style>
	.why-us {
		padding: var(--space-xl) var(--content-inset);
		background: var(--color-ice);
	}

	.why-us-intro {
		margin-bottom: var(--space-xl);
	}

	.cards {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
		margin-bottom: var(--space-xl);
	}

	.card {
		background: var(--color-white);
		border: 3px solid var(--color-blue);
		border-radius: var(--radius-md);
		overflow: hidden;
		width: 100%;
	}

	.card-header {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: var(--space-lg) var(--space-md);
		cursor: pointer;
		list-style: none;
		font-weight: 900;
	}

	.card-header::-webkit-details-marker {
		display: none;
	}

	.card-icon-wrap {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-sm);
		width: 100%;
	}

	.card-title {
		font-size: 1rem;
		font-weight: 900;
		text-transform: uppercase;
		text-align: center;
	}

	.toggle-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 24px;
		height: 24px;
		margin-top: var(--space-sm);
		border-radius: 50%;
		background: var(--color-accent);
		color: var(--color-white);
	}

	.toggle-bar--v {
		transform-origin: center;
		transition: opacity 0.2s ease, transform 0.2s ease;
	}

	.card[open] .toggle-bar--v {
		opacity: 0;
		transform: rotate(90deg);
	}

	.card-body {
		padding: 0 var(--space-lg) var(--space-lg);
	}

	.card-body .body-text {
		font-size: 1.3125rem;
		line-height: 1.6;
		margin: 0;
	}

	.quote-cta {
		font-family: var(--font-heading);
		font-size: 1.4875rem;
		line-height: 1.3;
		text-align: center;
		padding: 18px 20px;
		border-radius: var(--radius-md);
		border: 3px solid var(--color-cta);
		background: var(--color-white);
		color: var(--color-cta);
	}

	@media (min-width: 768px) {
		.cards {
			/* Keep all cards the same width across breakpoints */
			display: flex;
			flex-direction: column;
			align-items: stretch;
			gap: var(--space-md);
		}

		.card-body .body-text {
			text-align: center;
		}
	}
</style>
